# API mode: "mock" uses the in-browser mock API, "real" calls NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MODE=mock
# Base URL of the SIMS backend REST API (used only when NEXT_PUBLIC_API_MODE=real).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Simulated network latency for the mock API, in milliseconds.
NEXT_PUBLIC_MOCK_DELAY_MS=400
# Never put secrets in NEXT_PUBLIC_ variables: they are bundled into the browser.
